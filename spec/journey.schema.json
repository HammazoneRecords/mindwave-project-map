{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindwaveja.com/project-map/schemas/journey.schema.json",
  "title": "MindWave Project Journey file",
  "description": "A Journey FILE is an array of Journey objects. Per-type step requirements (move needs 'to'; act needs 'action' + 'target'; checkpoint needs 'label') are enforced by tools/validate_project_map.py, which also checks actions against the Map vocabulary.",
  "type": "array",
  "items": { "$ref": "#/$defs/journey" },
  "$defs": {
    "journey": {
      "type": "object",
      "required": ["schemaVersion", "id", "map", "initial", "steps"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "title": { "type": "string" },
        "version": { "type": "string" },
        "map": { "type": "string" },
        "initial": {
          "type": "object",
          "required": ["role", "node"],
          "properties": { "role": { "type": "string" }, "node": { "type": "string" } },
          "additionalProperties": false
        },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["move", "act", "checkpoint", "comment"] },
        "to": { "type": "string" },
        "target": { "type": "string" },
        "action": { "type": "string" },
        "expect": { "enum": ["allowed", "denied"] },
        "value": {},
        "label": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
