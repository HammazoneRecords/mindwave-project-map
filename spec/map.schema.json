{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindwaveja.com/project-map/schemas/map.schema.json",
  "title": "MindWave Project Map",
  "type": "object",
  "required": ["schemaVersion", "id", "nodes", "edges", "roles", "permissions"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "title": { "type": "string" },
    "version": { "type": "string", "description": "Optional human revision label. Findings also record the content hash, so two revisions with the same id stay distinguishable." },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "roles": { "type": "array", "items": { "type": "string" } },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "roleCapabilities": {
      "type": "object",
      "description": "role -> capabilities it holds; enforced against edge.requires by the runner (Phase 6.1).",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "entry": {
      "type": "object",
      "description": "Legal start positions (Phase 6.2): role-specific lists override the default.",
      "properties": {
        "default": { "type": "array", "items": { "type": "string" } },
        "roles": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }
      },
      "additionalProperties": false
    },
    "vocabulary": {
      "type": "object",
      "description": "Optional map-specific action -> relation vocabulary (Phase 6.4, invariant 5). Replaces the default CRUD vocabulary entirely when present.",
      "additionalProperties": { "type": "string" }
    },
    "permissions": { "type": "array", "items": { "$ref": "#/$defs/permission" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "source": {
      "type": "object",
      "description": "Where this Map was captured from (repository, branch, purpose).",
      "additionalProperties": true
    },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "state": { "type": "string" },
        "metadata": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "type"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "type": { "type": "string" },
        "requires": { "type": "array", "items": { "type": "string" } },
        "when": {
          "type": "object",
          "description": "Conditional edge (Phase 7.5): traversable only while the trace state satisfies the guard. State mutations live in the Trace, never the Map.",
          "properties": { "state": { "type": "string" } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "permission": {
      "type": "object",
      "required": ["subject", "relation", "object"],
      "properties": {
        "subject": { "type": "string" },
        "relation": { "type": "string" },
        "object": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
